generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(editor)
  canManageCategories Boolean   @default(false)
  avatar              String    @default("")
  phone               String    @default("")
  contactEmail        String    @default("")
  /// Shop admin UI language: "en" (default) or "ur"
  shopAdminLang       String    @default("en")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  articles            Article[]
  shops               Shop[]
  deviceTokens        DeviceToken[]
  driver              Driver?
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([order])
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String    @default("")
  images      String[]  @default([])
  categoryId  String?
  tags        String[]  @default([])
  authorId    String?
  status      Status    @default(draft)
  isCarousel  Boolean   @default(false)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation(fields: [authorId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([isCarousel])
}

model Settings {
  id             String   @id @default(cuid())
  key            String   @unique @default("site")
  siteName       String   @default("Narang Mandi")
  logo           String   @default("")
  tagline        String   @default("آپ کے شہر کی تازہ ترین خبریں")
  socialLinks    Json     @default("{}")
  contactEmail   String   @default("")
  breakingTicker String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// Lead-capture for the "register your shop / register as a driver" banners on
// the home page. Public form → stored here → admin reads at /admin/registrations.
enum RegistrationType {
  driver
  shop
}

model Registration {
  id           String           @id @default(cuid())
  type         RegistrationType
  name         String
  contact      String
  businessName String           @default("") // shop name (shop) or vehicle name/number (driver)
  hasLicense   Boolean          @default(false) // driving licence — drivers only
  image        String           @default("") // optional vehicle/shop photo
  isRead       Boolean          @default(false)
  ip           String           @default("")
  createdAt    DateTime         @default(now())

  @@index([type, createdAt])
  @@index([isRead, createdAt])
}

model Classified {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  description String              @default("")
  price       Int?
  negotiable  Boolean             @default(false)
  images      String[]            @default([])
  categoryId  String?
  location    String              @default("")
  contactName String              @default("")
  phone       String              @default("")
  isSold      Boolean             @default(false)
  saleCode    String?             @unique
  status      ClassifiedStatus    @default(pending)
  submittedBy String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  category    ClassifiedCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model ClassifiedCategory {
  id          String       @id @default(cuid())
  name        String
  nameEn      String       @default("")
  slug        String       @unique
  icon        String       @default("")
  order       Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classifieds Classified[]

  @@index([order])
}

model Message {
  id         String     @id @default(cuid())
  threadId   String
  authorName String     @default("گمنام")
  clientId   String     @default("")
  content    String
  replyToId  String?
  createdAt  DateTime   @default(now())
  replyTo    Message?   @relation("MessageToMessage", fields: [replyToId], references: [id])
  replies    Message[]  @relation("MessageToMessage")
  thread     Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reactions  Reaction[]

  @@index([replyToId])
  @@index([threadId])
}

model Place {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  categoryId    String?
  address       String         @default("")
  latitude      Float?
  longitude     Float?
  phone         String         @default("")
  rating        Float?
  ratingCount   Int?
  hours         String         @default("")
  googleMapsUrl String         @default("")
  status        PlaceStatus    @default(pending)
  submittedBy   String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      PlaceCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model PlaceCategory {
  id        String   @id @default(cuid())
  name      String
  nameEn    String   @default("")
  slug      String   @unique
  icon      String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  places    Place[]

  @@index([order])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  emoji     String
  clientId  String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji, clientId])
  @@index([messageId])
}

model Thread {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  description    String    @default("")
  authorName     String    @default("گمنام")
  clientId       String    @default("")
  isLocked       Boolean   @default(false)
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]

  @@index([lastActivityAt])
}

model Train {
  id            String   @id @default(cuid())
  name          String
  nameEn        String   @default("")
  trainType     String   @default("")
  upRoute       String   @default("")
  upNumber      String   @default("")
  upArrival     String   @default("")
  upDeparture   String   @default("")
  downRoute     String   @default("")
  downNumber    String   @default("")
  downArrival   String   @default("")
  downDeparture String   @default("")
  classes       String   @default("")
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
}

// ---------- Dukanen (shops / e-commerce) ----------

model Shop {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String         @default("")
  logo        String         @default("")
  coverImage  String         @default("")
  phone       String         @default("")
  whatsapp    String         @default("")
  address     String         @default("")
  ownerId     String
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User           @relation(fields: [ownerId], references: [id])
  categories  ShopCategory[]
  products    Product[]
  orders      Order[]

  @@index([ownerId])
  @@index([isActive])
}

model ShopCategory {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  nameEn    String    @default("")
  slug      String    @unique
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([shopId])
}

model Product {
  id          String        @id @default(cuid())
  shopId      String
  categoryId  String?
  name        String
  slug        String        @unique
  description String        @default("")
  price       Int           @default(0)
  stock       Int           @default(0)
  images      String[]      @default([])
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category    ShopCategory? @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([shopId])
  @@index([categoryId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  shopId        String
  customerName  String
  customerPhone String
  address       String      @default("")
  note          String      @default("")
  total         Int         @default(0)
  status        OrderStatus @default(pending)
  /// FCM token of the device that placed the order. Checkout is a guest flow,
  /// so this is the only handle we have on a customer who never logs in.
  deviceToken   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shop          Shop        @relation(fields: [shopId], references: [id])
  items         OrderItem[]
  notifications NotificationLog[]

  @@index([shopId])
  @@index([status])
}

/// One row per push/WhatsApp target we tried to reach. Exists so "the shopkeeper
/// says they never got the order" has an answer other than a guess.
model NotificationLog {
  id        String   @id @default(cuid())
  /// Exactly one of orderId / rideId is set. Both are nullable because the log
  /// serves two unrelated subjects; the dispatcher refuses to write a row with
  /// neither.
  orderId   String?
  rideId    String?
  /// "order_placed" | "order_status" | "ride_new" | "ride_bid" | "ride_assigned" | "ride_cancelled"
  event     String
  /// "fcm" | "whatsapp"
  channel   String
  /// "shop" | "customer" | "driver"
  audience  String
  /// Phone number, or the tail of a device token — enough to identify, not to reuse.
  target    String   @default("")
  /// "sent" | "failed" | "skipped" | "delivered" | "read" | "undelivered"
  ///
  /// The last three only ever arrive from the WhatsApp webhook. "sent" means
  /// Meta accepted the message, which is not the same as it reaching a handset —
  /// that distinction is the whole reason the webhook exists.
  status    String
  error     String?
  /// WhatsApp's `wamid`, kept so a webhook status can find the row it belongs
  /// to. Null for FCM and for anything that never reached the provider.
  providerMessageId String?
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ride      Ride?    @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([rideId])
  @@index([createdAt])
  /// Every webhook status arrives keyed by this and nothing else.
  @@index([providerMessageId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  /// Null for guest customers — they have no account, but they still get pushes
  /// via the token recorded on their order.
  userId    String?
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum Role {
  admin
  editor
  shopkeeper
  driver
}

enum OrderStatus {
  pending
  processing
  fulfilled
  cancelled
}

enum Status {
  draft
  published
}

enum ClassifiedStatus {
  pending
  approved
  rejected
}

enum PlaceStatus {
  pending
  approved
  rejected
}

// ---------------------------------------------------------------- Taxi / rides

/// A driver's profile. Kept separate from User rather than widening it: a bid
/// points at a profile the database can enforce, not at a User row that merely
/// happens to carry role='driver'. Unlike Shop.ownerId this is @unique, so the
/// owner lookup is an exact findUnique instead of "the oldest row that matches".
model Driver {
  id             String     @id @default(cuid())
  userId         String     @unique
  phone          String     @default("")
  whatsapp       String     @default("")
  /// Free text, as the shopkeeper writes it: رکشہ / کار / بائیک.
  vehicleType    String     @default("")
  vehicleNumber  String     @default("")
  photo          String     @default("")
  isActive       Boolean    @default(true)
  isVerified     Boolean    @default(false)
  completedRides Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bids           Bid[]
  assignedRides  Ride[]     @relation("AssignedDriver")

  /// Serves both the push fan-out to active drivers and the admin filter.
  @@index([isActive])
}

/// A ride request from a guest. Locations are plain text on purpose — no map,
/// no coordinates: people here describe a place by name, not by pin.
model Ride {
  id               String      @id @default(cuid())
  /// 8-digit handle the customer keeps, paired with their phone to prove ownership.
  rideCode         String      @unique
  /// Names the customer's private socket room. Never leaves a customer response.
  accessToken      String      @unique
  customerName     String
  customerPhone    String
  pickupText       String
  dropoffText      String
  /// Free text: "ابھی" / "شام 5 بجے".
  whenText         String      @default("")
  note             String      @default("")
  status           RideStatus  @default(open)
  assignedDriverId String?
  acceptedBidId    String?     @unique
  /// Snapshot of the winning bid's price. Deliberately not read through
  /// acceptedBid.price — a driver editing a bid later must not rewrite an
  /// already-agreed fare.
  agreedPrice      Int         @default(0)
  bidCount         Int         @default(0)
  lastBidAt        DateTime?
  /// When the customer was last told about bids over WhatsApp. Separate from
  /// lastBidAt, which moves on every bid — this one only moves when a billable
  /// message actually goes out, which is what makes it usable as a cooldown.
  lastWhatsAppAt   DateTime?
  /// FCM token of the device that requested the ride — the only handle on a
  /// customer who never logs in. Stripped from every response.
  deviceToken      String?
  cancelReason     String      @default("")
  /// "customer" | "driver" | "admin" | "system"
  cancelledBy      String      @default("")
  ip               String      @default("")
  expiresAt        DateTime
  assignedAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  driver           Driver?     @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  acceptedBid      Bid?        @relation("AcceptedBid", fields: [acceptedBidId], references: [id], onDelete: SetNull)
  bids             Bid[]       @relation("RideBids")
  events           RideEvent[]
  notifications    NotificationLog[]

  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([assignedDriverId, status])
  @@index([customerPhone, status])
}

model Bid {
  id          String    @id @default(cuid())
  rideId      String
  driverId    String
  price       Int
  etaMinutes  Int       @default(0)
  note        String    @default("")
  status      BidStatus @default(active)
  /// Capped, so a price war cannot become a write loop.
  reviseCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ride        Ride      @relation("RideBids", fields: [rideId], references: [id], onDelete: Cascade)
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  acceptedFor Ride?     @relation("AcceptedBid")

  /// One bid per driver per ride: re-bidding is an update, so no driver can
  /// flood a request.
  @@unique([rideId, driverId])
  @@index([rideId, status])
  @@index([driverId, createdAt])
}

/// Append-only history of what happened to a ride. Holds no foreign key to Bid
/// or User on purpose, so it survives their deletion — this is the record that
/// answers "the driver says the customer never accepted".
model RideEvent {
  id          String   @id @default(cuid())
  rideId      String
  /// ride_created | bid_placed | bid_revised | bid_withdrawn | bid_accepted | ride_completed | ride_cancelled
  type        String
  /// "customer" | "driver" | "admin" | "system"
  actor       String   @default("system")
  actorUserId String   @default("")
  bidId       String   @default("")
  fromStatus  String   @default("")
  toStatus    String   @default("")
  price       Int      @default(0)
  createdAt   DateTime @default(now())
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
}

enum RideStatus {
  open
  assigned
  completed
  cancelled
}

enum BidStatus {
  active
  withdrawn
  accepted
  rejected
}

/// Outgoing SMS, queued for the Android gateway phone to collect.
///
/// A durable queue rather than a direct send: the phone is not always reachable
/// at the moment a ride is posted, so the row is written first and the phone
/// fetches it whenever it next polls. `NotificationLog` cannot serve this — its
/// rows are written *after* a send resolves, and carry no claim or retry state.
model SmsOutbox {
  id     String @id @default(cuid())
  /// E.164 without the +, matching the WhatsApp channel's convention.
  phone  String
  body   String
  /// "pending" | "claimed" | "sent" | "delivered" | "failed"
  ///
  /// "claimed" exists so two concurrent polls cannot hand the same message to
  /// the phone twice; the row is claimed in the same transaction that reads it.
  status String @default("pending")
  /// Bounded so a permanently undeliverable number cannot be retried forever.
  attempts  Int       @default(0)
  claimedAt DateTime?
  sentAt    DateTime?
  error     String?
  /// The NotificationLog row this message belongs to, so a status callback can
  /// update both. Null for anything sent outside the notification pipeline.
  logId     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// The gateway polls by status, oldest first.
  @@index([status, createdAt])
}
