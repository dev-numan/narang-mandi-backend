generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(editor)
  canManageCategories Boolean   @default(false)
  avatar              String    @default("")
  phone               String    @default("")
  contactEmail        String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  articles            Article[]
  shops               Shop[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([order])
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String    @default("")
  images      String[]  @default([])
  categoryId  String?
  tags        String[]  @default([])
  authorId    String?
  status      Status    @default(draft)
  isCarousel  Boolean   @default(false)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation(fields: [authorId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([isCarousel])
}

model Settings {
  id             String   @id @default(cuid())
  key            String   @unique @default("site")
  siteName       String   @default("Narang Mandi")
  logo           String   @default("")
  tagline        String   @default("آپ کے شہر کی تازہ ترین خبریں")
  socialLinks    Json     @default("{}")
  contactEmail   String   @default("")
  breakingTicker String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Classified {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  description String              @default("")
  price       Int?
  negotiable  Boolean             @default(false)
  images      String[]            @default([])
  categoryId  String?
  location    String              @default("")
  contactName String              @default("")
  phone       String              @default("")
  isSold      Boolean             @default(false)
  saleCode    String?             @unique
  status      ClassifiedStatus    @default(pending)
  submittedBy String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  category    ClassifiedCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model ClassifiedCategory {
  id          String       @id @default(cuid())
  name        String
  nameEn      String       @default("")
  slug        String       @unique
  icon        String       @default("")
  order       Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classifieds Classified[]

  @@index([order])
}

model Message {
  id         String     @id @default(cuid())
  threadId   String
  authorName String     @default("گمنام")
  clientId   String     @default("")
  content    String
  replyToId  String?
  createdAt  DateTime   @default(now())
  replyTo    Message?   @relation("MessageToMessage", fields: [replyToId], references: [id])
  replies    Message[]  @relation("MessageToMessage")
  thread     Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reactions  Reaction[]

  @@index([replyToId])
  @@index([threadId])
}

model Place {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  categoryId    String?
  address       String         @default("")
  latitude      Float?
  longitude     Float?
  phone         String         @default("")
  rating        Float?
  ratingCount   Int?
  hours         String         @default("")
  googleMapsUrl String         @default("")
  status        PlaceStatus    @default(pending)
  submittedBy   String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      PlaceCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model PlaceCategory {
  id        String   @id @default(cuid())
  name      String
  nameEn    String   @default("")
  slug      String   @unique
  icon      String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  places    Place[]

  @@index([order])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  emoji     String
  clientId  String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji, clientId])
  @@index([messageId])
}

model Thread {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  description    String    @default("")
  authorName     String    @default("گمنام")
  clientId       String    @default("")
  isLocked       Boolean   @default(false)
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]

  @@index([lastActivityAt])
}

model Train {
  id            String   @id @default(cuid())
  name          String
  nameEn        String   @default("")
  trainType     String   @default("")
  upRoute       String   @default("")
  upNumber      String   @default("")
  upArrival     String   @default("")
  upDeparture   String   @default("")
  downRoute     String   @default("")
  downNumber    String   @default("")
  downArrival   String   @default("")
  downDeparture String   @default("")
  classes       String   @default("")
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
}

// ---------- Dukanen (shops / e-commerce) ----------

model Shop {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String         @default("")
  logo        String         @default("")
  coverImage  String         @default("")
  phone       String         @default("")
  whatsapp    String         @default("")
  address     String         @default("")
  ownerId     String
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User           @relation(fields: [ownerId], references: [id])
  categories  ShopCategory[]
  products    Product[]
  orders      Order[]

  @@index([ownerId])
  @@index([isActive])
}

model ShopCategory {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  nameEn    String    @default("")
  slug      String    @unique
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([shopId])
}

model Product {
  id          String        @id @default(cuid())
  shopId      String
  categoryId  String?
  name        String
  slug        String        @unique
  description String        @default("")
  price       Int           @default(0)
  stock       Int           @default(0)
  images      String[]      @default([])
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category    ShopCategory? @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([shopId])
  @@index([categoryId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  shopId        String
  customerName  String
  customerPhone String
  address       String      @default("")
  note          String      @default("")
  total         Int         @default(0)
  status        OrderStatus @default(pending)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shop          Shop        @relation(fields: [shopId], references: [id])
  items         OrderItem[]

  @@index([shopId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum Role {
  admin
  editor
  shopkeeper
}

enum OrderStatus {
  pending
  processing
  fulfilled
  cancelled
}

enum Status {
  draft
  published
}

enum ClassifiedStatus {
  pending
  approved
  rejected
}

enum PlaceStatus {
  pending
  approved
  rejected
}
