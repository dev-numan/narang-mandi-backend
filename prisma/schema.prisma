generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(editor)
  avatar       String    @default("")
  phone        String    @default("")
  contactEmail String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([order])
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String    @default("")
  images      String[]  @default([])
  categoryId  String?
  tags        String[]  @default([])
  authorId    String?
  status      Status    @default(draft)
  isCarousel  Boolean   @default(false)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation(fields: [authorId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([isCarousel])
}

model Settings {
  id             String   @id @default(cuid())
  key            String   @unique @default("site")
  siteName       String   @default("نارنگ منڈی نیوز")
  logo           String   @default("")
  tagline        String   @default("آپ کے شہر کی تازہ ترین خبریں")
  socialLinks    Json     @default("{}")
  contactEmail   String   @default("")
  breakingTicker String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Classified {
  id                 String              @id
  title              String
  slug               String              @unique
  description        String              @default("")
  price              Int?
  negotiable         Boolean             @default(false)
  images             String[]            @default([])
  categoryId         String?
  location           String              @default("")
  contactName        String              @default("")
  phone              String              @default("")
  isSold             Boolean             @default(false)
  status             ClassifiedStatus    @default(pending)
  submittedBy        String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  ClassifiedCategory ClassifiedCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model ClassifiedCategory {
  id         String       @id
  name       String
  nameEn     String       @default("")
  slug       String       @unique
  icon       String       @default("")
  order      Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  Classified Classified[]

  @@index([order])
}

model Message {
  id            String     @id
  threadId      String
  authorName    String     @default("گمنام")
  clientId      String     @default("")
  content       String
  replyToId     String?
  createdAt     DateTime   @default(now())
  Message       Message?   @relation("MessageToMessage", fields: [replyToId], references: [id])
  other_Message Message[]  @relation("MessageToMessage")
  Thread        Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  Reaction      Reaction[]

  @@index([replyToId])
  @@index([threadId])
}

model Place {
  id            String         @id
  name          String
  slug          String         @unique
  categoryId    String?
  address       String         @default("")
  latitude      Float?
  longitude     Float?
  phone         String         @default("")
  rating        Float?
  ratingCount   Int?
  hours         String         @default("")
  googleMapsUrl String         @default("")
  status        PlaceStatus    @default(pending)
  submittedBy   String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  PlaceCategory PlaceCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}

model PlaceCategory {
  id        String   @id
  name      String
  nameEn    String   @default("")
  slug      String   @unique
  icon      String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Place     Place[]

  @@index([order])
}

model Reaction {
  id        String   @id
  messageId String
  emoji     String
  clientId  String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji, clientId])
  @@index([messageId])
}

model Thread {
  id             String    @id
  title          String
  slug           String    @unique
  description    String    @default("")
  authorName     String    @default("گمنام")
  clientId       String    @default("")
  isLocked       Boolean   @default(false)
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Message        Message[]

  @@index([lastActivityAt])
}

model Train {
  id            String   @id
  name          String
  nameEn        String   @default("")
  trainType     String   @default("")
  upRoute       String   @default("")
  upNumber      String   @default("")
  upArrival     String   @default("")
  upDeparture   String   @default("")
  downRoute     String   @default("")
  downNumber    String   @default("")
  downArrival   String   @default("")
  downDeparture String   @default("")
  classes       String   @default("")
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([order])
}

enum Role {
  admin
  editor
}

enum Status {
  draft
  published
}

enum ClassifiedStatus {
  pending
  approved
  rejected
}

enum PlaceStatus {
  pending
  approved
  rejected
}
