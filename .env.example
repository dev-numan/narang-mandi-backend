# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — Neon Postgres (or any Postgres).
# DATABASE_URL: pooled connection used at runtime (Neon "-pooler" host).
# DIRECT_URL:   direct connection used for migrations / `prisma db push` (host without "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=10d

# First admin (used by `npm run seed`)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@naningmandi.com
SEED_ADMIN_PASSWORD=admin12345

# Image storage: "local" (saves to /uploads) or "cloudinary"
STORAGE_DRIVER=local

# Cloudinary (only required when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order notifications. Both channels are optional — an absent credential means
# that channel reports itself unconfigured and is skipped, never an error.

# Firebase Cloud Messaging: the service-account JSON, on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API (Meta). Templates nm_new_order_shop,
# nm_order_placed_customer and nm_order_status_customer must be approved first.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Any string you choose; paste the same one into Meta's webhook setup form.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret from the Meta app dashboard. Signature checks are skipped when
# blank, so set it before the endpoint is publicly reachable.
WHATSAPP_APP_SECRET=
