# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — Neon Postgres (or any Postgres).
# DATABASE_URL: pooled connection used at runtime (Neon "-pooler" host).
# DIRECT_URL:   direct connection used for migrations / `prisma db push` (host without "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=10d

# First admin (used by `npm run seed`)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@naningmandi.com
SEED_ADMIN_PASSWORD=admin12345

# Image storage: "local" (saves to /uploads) or "cloudinary"
STORAGE_DRIVER=local

# Cloudinary (only required when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
