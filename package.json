{
  "name": "narangmandi-server",
  "version": "1.0.0",
  "description": "Narang Mandi Urdu City News \u2014 Express + Postgres (Neon) API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "node src/seed/seed.js",
    "seed:places": "node src/scripts/seed-places.js",
    "seed:trains": "node src/scripts/seed-trains.js",
    "seed:classifieds": "node src/scripts/seed-classified-categories.js",
    "seed:classified-listings": "node src/scripts/seed-classified-listings.js",
    "seed:shops": "node src/scripts/seed-shops.js",
    "audit:articles": "node src/scripts/audit-article-content.js",
    "clean:articles": "node src/scripts/clean-article-content.js",
    "restore:articles": "node src/scripts/restore-article-snapshot.js",
    "briefs:articles": "node src/scripts/generate-reporting-briefs.js",
    "postinstall": "prisma generate",
    "test": "node test-e2e.mjs",
    "test:unit": "node --test \"src/**/*.test.mjs\"",
    "test:e2e": "node test-e2e.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
